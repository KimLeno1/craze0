{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "handle": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "archetype": { "type": "string" },
        "rep": { "type": "number" },
        "level": { "type": "number" },
        "coins": { "type": "number" },
        "gems": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "BANNED", "RESTRICTED"] },
        "lastLogin": { "type": "string" },
        "totalSpent": { "type": "number" },
        "role": { "type": "string", "enum": ["client", "admin", "supplier"] }
      },
      "required": ["id", "handle", "email", "status", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Represents a product in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "shippingFee": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "gender": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } },
        "inStock": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "viewers": { "type": "number" },
        "stockCount": { "type": "number" },
        "hypeScore": { "type": "number" },
        "velocityScore": { "type": "number" },
        "isHallOfFame": { "type": "boolean" },
        "brand": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "supplierId": { "type": "string" },
        "sizes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "price", "originalPrice", "category", "supplierId"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Represents a supplier in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string" },
        "region": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "RESTRICTED"] },
        "performanceScore": { "type": "number" },
        "totalRevenueYield": { "type": "number" },
        "joinedDate": { "type": "string" }
      },
      "required": ["id", "name", "contactEmail", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a customer order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"] },
        "timestamp": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "phone": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "userId", "total", "status", "timestamp", "items"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Represents a promotional code.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["PERCENT", "AMOUNT"] },
        "value": { "type": "number" },
        "description": { "type": "string" },
        "expiresAt": { "type": "string" },
        "usageLimit": { "type": "number" }
      },
      "required": ["id", "code", "type", "value", "expiresAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents a system notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["INFO", "URGENT", "REWARD", "WELCOME"] },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "recipientId": { "type": "string" }
      },
      "required": ["id", "title", "message", "type", "timestamp", "read"]
    },
    "UserCredit": {
      "title": "UserCredit",
      "description": "Represents a sponsorship credit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "number" },
        "status": { "type": "string", "enum": ["AVAILABLE", "USED"] }
      },
      "required": ["id", "userId", "amount", "createdAt", "status"]
    },
    "SocialPost": {
      "title": "SocialPost",
      "description": "Represents a social media post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userImage": { "type": "string" },
        "image": { "type": "string" },
        "caption": { "type": "string" },
        "likes": { "type": "number" },
        "loves": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "lovedBy": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "userId", "username", "image", "timestamp"]
    },
    "Bundle": {
      "title": "Bundle",
      "description": "Represents a synergy kit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "bundlePrice": { "type": "number" },
        "products": { "type": "array", "items": { "type": "object" } },
        "expiresIn": { "type": "number" }
      },
      "required": ["id", "name", "bundlePrice", "products"]
    },
    "PayForMeRequest": {
      "title": "PayForMeRequest",
      "description": "Represents a pay-for-me request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterId": { "type": "string" },
        "requesterName": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "timestamp": { "type": "number" },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "requesterId", "amount", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog."
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier profiles."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/promos/{promoId}": {
      "schema": "PromoCode",
      "description": "Promotional codes."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System notifications."
    },
    "/credits/{creditId}": {
      "schema": "UserCredit",
      "description": "Sponsorship credits."
    },
    "/social_posts/{postId}": {
      "schema": "SocialPost",
      "description": "Social media posts."
    },
    "/bundles/{bundleId}": {
      "schema": "Bundle",
      "description": "Synergy kits."
    },
    "/pay_for_me/{requestId}": {
      "schema": "PayForMeRequest",
      "description": "Pay-for-me requests."
    }
  }
}
